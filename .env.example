# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TIINGO_API_TOKEN: Server-side API token for Tiingo real market data feed (EURUSD POC).
# NEVER expose this token to browser JavaScript or client-facing bundles.
TIINGO_API_TOKEN="your_tiingo_api_token_here"

# USE_REAL_MARKET_DATA: Set to "true" to switch from synthetic MarketEngine to Tiingo live feed.
USE_REAL_MARKET_DATA="false"

# VITE_WS_URL: Optional client-side WebSocket URL for separated frontend deployments (e.g. Vercel).
# If unset, the client automatically defaults to the same-origin host (ws://localhost:3000/ws or wss://current-host/ws).
VITE_WS_URL=""

# CRM_LAUNCH_SECRET: Server-side cryptographic secret for validating CRM external launch tokens.
# Shared between the CRM backend and Trading Platform server. NEVER expose to Vite frontend.
CRM_LAUNCH_SECRET="your_crm_launch_shared_secret_here"

# CRM_M2M_SECRET: Server-side cryptographic shared secret for Step 3 CRM -> Trading Engine M2M funding operations.
# Required on Render production to authenticate HMAC-SHA256 signatures from CRM backend.
CRM_M2M_SECRET="your_crm_m2m_shared_secret_here"

# ADMIN_API_SECRET: Server-side secret for Step 5 CRM Admin Panel API authentication (X-Admin-Key or ADMIN_JWT).
ADMIN_API_SECRET="your_admin_api_secret_here"

# TWELVE_DATA_API_KEY: Server-side API key for Twelve Data secondary market data feed (Metals, Crypto, FX fallback).
# NEVER expose this key to browser JavaScript or client-facing bundles. Optional.
TWELVE_DATA_API_KEY="your_twelve_data_api_key_here"

