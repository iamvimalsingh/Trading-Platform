# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TIINGO_API_TOKEN: Server-side API token for Tiingo real market data feed (EURUSD POC).
# NEVER expose this token to browser JavaScript or client-facing bundles.
TIINGO_API_TOKEN="your_tiingo_api_token_here"

# USE_REAL_MARKET_DATA: Set to "true" to switch from synthetic MarketEngine to Tiingo live feed.
USE_REAL_MARKET_DATA="false"

# VITE_WS_URL: Optional client-side WebSocket URL for separated frontend deployments (e.g. Vercel).
# If unset, the client automatically defaults to the same-origin host (ws://localhost:3000/ws or wss://current-host/ws).
VITE_WS_URL=""

# CRM_LAUNCH_SECRET: Server-side cryptographic secret for validating CRM external launch tokens.
# Shared between the CRM backend and Trading Platform server. NEVER expose to Vite frontend.
CRM_LAUNCH_SECRET="your_crm_launch_shared_secret_here"

